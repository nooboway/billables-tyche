# Supabase (required by both backend API and frontend SSR)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# Frontend (Vite build-time — copy these from above with VITE_ prefix)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# Express API server (local dev only — Vercel sets PORT automatically)
PORT=3000
NODE_ENV=development