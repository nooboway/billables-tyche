# ─────────────────────────────────────────────────────────────────────────────
# BILLABLES — Environment Variables
# Copy this to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (shared across all apps) ──────────────────────────────────────
# Found at: supabase.com → your project → Settings → API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"       # secret — server only
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"         # safe to expose client-side

# ── Web frontend (Vite build-time — prefix must be VITE_) ──────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# ── Express backend (apps/backend) ─────────────────────────────────────────
# Comma-separated list of origins allowed to call the Express API (web + mobile web)
# Example: https://billables-api.vercel.app,https://billables.tyche.co
ALLOWED_ORIGINS="http://localhost:5173"
PORT=3000
NODE_ENV=development

# ── Mobile app (apps/mobile) ───────────────────────────────────────────────
# The deployed Express backend URL. EXPO_PUBLIC_ prefix makes it available in JS.
# Production: https://billables-api.vercel.app/api/v1
# Local dev:  http://localhost:3000/api/v1  (default if unset)
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"